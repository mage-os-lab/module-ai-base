<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnEmptyTestSuite="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>Test/Unit</directory>
        </testsuite>
        <!--
            The chat client tests, which run against the real symfony/ai-platform classes and
            need nothing Magento generates. The Magento job runs them too, now that the module
            requires the platform; CI also runs this suite standalone across the full PHP range
            composer.json claims, which the Magento matrix does not cover.

            Deliberately not the whole Unit suite: the rest mocks Magento's auto-generated
            *Factory classes, which the ObjectManager code generator fabricates only inside a
            Magento install. Those tests are covered by the Magento job instead, so between the
            two jobs every test runs somewhere for real.
        -->
        <testsuite name="Platform">
            <directory>Test/Unit/Model/Chat</directory>
            <file>Test/Unit/Model/Client/SymfonyAiClientChatTest.php</file>
            <file>Test/Unit/Model/Client/SymfonyAiClientStreamFailureTest.php</file>
            <file>Test/Unit/Model/Client/SymfonyAiClientTruncatedStreamTest.php</file>
            <file>Test/Unit/Model/Client/UsageNormalizerTest.php</file>
            <file>Test/Unit/Model/Client/OpenCodeServerToolLoopTest.php</file>
        </testsuite>
        <!--
            Needs a running Magento install with the integration test framework, so it cannot be
            run from this repo directly; see CLAUDE.md for the command. CI runs it through the
            reusable workflow's `integration_test` job, which points Magento's own
            dev/tests/integration/phpunit.xml.dist at this directory inside the installed module.
        -->
        <testsuite name="Integration">
            <directory>Test/Integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
