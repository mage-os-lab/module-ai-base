<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="MageOS\AiBase\Api\AiServiceSelectorInterface" type="MageOS\AiBase\Model\AiServiceSelector"/>
    <preference for="MageOS\AiBase\Api\Data\AiServiceInterface" type="MageOS\AiBase\Model\AiService"/>
    <preference for="MageOS\AiBase\Api\Data\FieldDescriptorInterface" type="MageOS\AiBase\Model\FieldDescriptor"/>
    <preference for="MageOS\AiBase\Api\AiClientFactoryInterface" type="MageOS\AiBase\Model\Client\ClientFactory"/>

    <!-- Chat value objects. Consumer modules are told to type-hint against Api only, which is only
         honest if there is a way to obtain one without naming a Model class: these preferences are
         what make the generated *InterfaceFactory classes (and ChatRequestBuilderInterfaceFactory)
         resolve. Without them, following that rule is impossible. -->
    <preference for="MageOS\AiBase\Api\ChatRequestBuilderInterface" type="MageOS\AiBase\Model\Chat\ChatRequestBuilder"/>
    <preference for="MageOS\AiBase\Api\Data\ChatRequestInterface" type="MageOS\AiBase\Model\Chat\ChatRequest"/>
    <preference for="MageOS\AiBase\Api\Data\ChatMessageInterface" type="MageOS\AiBase\Model\Chat\ChatMessage"/>
    <preference for="MageOS\AiBase\Api\Data\ChatResponseInterface" type="MageOS\AiBase\Model\Chat\ChatResponse"/>
    <preference for="MageOS\AiBase\Api\Data\ToolDefinitionInterface" type="MageOS\AiBase\Model\Chat\ToolDefinition"/>
    <preference for="MageOS\AiBase\Api\Data\ToolCallInterface" type="MageOS\AiBase\Model\Chat\ToolCall"/>
    <preference for="MageOS\AiBase\Api\Data\TokenUsageInterface" type="MageOS\AiBase\Model\Chat\TokenUsage"/>
    <preference for="MageOS\AiBase\Api\Data\StreamChunkInterface" type="MageOS\AiBase\Model\Chat\StreamChunk"/>

    <!-- Same reasoning as the chat value objects above: the recording decorator and the
         repository both build a UsageRecordInterface without naming Model\Usage\UsageRecord
         directly, which is only possible if the generated UsageRecordInterfaceFactory has
         something to resolve to. -->
    <preference for="MageOS\AiBase\Api\Data\UsageRecordInterface" type="MageOS\AiBase\Model\Usage\UsageRecord"/>

    <!-- The daily roll-up's repository (task 010) depends on the narrow
         UsageDailyResourceInterface rather than the concrete resource model, so its unit tests can
         hand it a small in-memory fake instead of a real database connection. This is what
         resolves that interface to the one class that implements it. -->
    <preference for="MageOS\AiBase\Model\ResourceModel\Usage\UsageDailyResourceInterface"
                type="MageOS\AiBase\Model\ResourceModel\Usage\UsageDaily"/>
    <preference for="MageOS\AiBase\Api\UsageDailyRepositoryInterface" type="MageOS\AiBase\Model\Usage\UsageDailyRepository"/>

    <!-- The raw usage log's repository (task 005) depends on the narrow
         UsageLogResourceInterface rather than the concrete resource model, so its unit tests can
         hand it a small in-memory fake instead of a real database connection. This is what
         resolves that interface to the one class that implements it. -->
    <preference for="MageOS\AiBase\Model\ResourceModel\Usage\UsageLogResourceInterface"
                type="MageOS\AiBase\Model\ResourceModel\Usage\UsageLog"/>
    <preference for="MageOS\AiBase\Api\UsageRecordRepositoryInterface" type="MageOS\AiBase\Model\Usage\UsageRecordRepository"/>

    <!-- Same reasoning one level up: UsageMaintenance commits each day's aggregate and the delete
         behind it together, and depends on the narrow UsageTransactionInterface so its unit tests
         can run that unit in memory rather than against a real connection. -->
    <preference for="MageOS\AiBase\Model\Usage\UsageTransactionInterface"
                type="MageOS\AiBase\Model\Usage\UsageTransaction"/>

    <!-- The read API (task 013) that merges the raw and daily tables into one answer, plus the
         value objects its own methods return: same reasoning as the chat value objects above,
         a consumer type-hinting Api\Data\UsageTotalsInterface or UsageBreakdownInterface needs
         somewhere for the generated *InterfaceFactory classes to resolve to. -->
    <preference for="MageOS\AiBase\Api\UsageStatsInterface" type="MageOS\AiBase\Model\Usage\UsageStats"/>
    <preference for="MageOS\AiBase\Api\Data\UsageTotalsInterface" type="MageOS\AiBase\Model\Usage\UsageTotals"/>
    <preference for="MageOS\AiBase\Api\Data\UsageBreakdownInterface" type="MageOS\AiBase\Model\Usage\UsageBreakdown"/>

    <!-- The services config holds provider credentials, so keep it out of app/etc/config.php,
         which is commonly committed. Values are encrypted at rest, so what would leak is
         ciphertext, but an install that dumped config before credentials were encrypted has the
         plaintext key in a tracked file.

         This changes which file `app:config:dump` writes to, not whether it writes: a sensitive
         path goes to app/etc/env.php instead, and deployment config wins over the database either
         way, so the field is still read-only in the admin afterwards. That is why the admin form
         checks and says so; see Block\Adminhtml\Configuration\Services::isReadOnly(). -->

    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="mageos_ai/services/configuration" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <!-- Every AI backend this module knows about, in one place. The admin form, the option source
         consumer modules point their own system.xml at, the sensitive-data processor and the
         model-list refresh controller all read this same registry, so registering a provider is
         this entry and nothing else. A provider missing from one consumer does not fail loudly, it
         degrades: a raw machine code in an admin dropdown, or credentials falling back to a
         field-name heuristic instead of the provider's declared field schema. -->
    <type name="MageOS\AiBase\Model\ServiceRegistry">
        <arguments>
            <argument name="services" xsi:type="array">
                <item name="anthropic" xsi:type="object">MageOS\AiBase\AiServices\Anthropic</item>
                <item name="azure" xsi:type="object">MageOS\AiBase\AiServices\Azure</item>
                <item name="deepseek" xsi:type="object">MageOS\AiBase\AiServices\Deepseek</item>
                <item name="google" xsi:type="object">MageOS\AiBase\AiServices\Google</item>
                <item name="huggingface" xsi:type="object">MageOS\AiBase\AiServices\HuggingFace</item>
                <item name="lmstudio" xsi:type="object">MageOS\AiBase\AiServices\LmStudio</item>
                <item name="ollama" xsi:type="object">MageOS\AiBase\AiServices\Ollama</item>
                <item name="openrouter" xsi:type="object">MageOS\AiBase\AiServices\OpenRouter</item>
                <item name="openai" xsi:type="object">MageOS\AiBase\AiServices\OpenAi</item>
                <item name="openai_compatible" xsi:type="object">MageOS\AiBase\AiServices\OpenAiCompatible</item>
            </argument>
        </arguments>
    </type>

    <!-- Symfony AI provider bridges. Soft dependency: FQCN strings, resolved only when a client
         is created, and the package name so the admin form can say what to install. Since
         symfony/ai-platform 0.12 each bridge ships as its own package. Every bundled provider has
         one; a third party registering a provider without a bridge is marked unsupported in the
         admin form, since there is nothing an administrator could install for it.

         `dialect` names the request-option shape the bridge speaks, which decides how the universal
         options are spelled on the wire (see Model\Client\OptionNormalizer below). It belongs here
         because it is a property of the bridge, not of the provider's credentials. -->
    <type name="MageOS\AiBase\Model\Client\BridgeRegistry">
        <arguments>
            <argument name="bridges" xsi:type="array">
                <item name="anthropic" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\Anthropic\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-anthropic-platform</item>
                    <item name="dialect" xsi:type="string">anthropic_messages</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\Anthropic\ModelCatalog</item>
                    <item name="cache_outside_prompt" xsi:type="boolean">true</item>
                </item>
                <item name="azure" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\Azure\OpenAi\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-azure-platform</item>
                    <item name="dialect" xsi:type="string">openai_responses</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\Azure\OpenAi\ModelCatalog</item>
                </item>
                <item name="deepseek" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\DeepSeek\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-deep-seek-platform</item>
                    <item name="dialect" xsi:type="string">openai_chat</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\DeepSeek\ModelCatalog</item>
                </item>
                <item name="google" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\Gemini\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-gemini-platform</item>
                    <item name="dialect" xsi:type="string">gemini</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\Gemini\ModelCatalog</item>
                </item>
                <item name="huggingface" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\HuggingFace\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-hugging-face-platform</item>
                    <item name="dialect" xsi:type="string">openai_chat</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\HuggingFace\ModelCatalog</item>
                </item>
                <item name="lmstudio" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\LmStudio\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-lm-studio-platform</item>
                    <item name="dialect" xsi:type="string">openai_chat</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\LmStudio\ModelCatalog</item>
                </item>
                <item name="ollama" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\Ollama\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-ollama-platform</item>
                    <item name="dialect" xsi:type="string">ollama</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\Ollama\ModelCatalog</item>
                </item>
                <item name="openrouter" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\OpenRouter\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-open-router-platform</item>
                    <item name="dialect" xsi:type="string">openai_chat</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\OpenRouter\ModelCatalog</item>
                </item>
                <item name="openai" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\OpenAi\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-open-ai-platform</item>
                    <item name="dialect" xsi:type="string">openai_responses</item>
                    <item name="catalog" xsi:type="string">Symfony\AI\Platform\Bridge\OpenAi\ModelCatalog</item>
                </item>
                <item name="openai_compatible" xsi:type="array">
                    <item name="factory" xsi:type="string">Symfony\AI\Platform\Bridge\Generic\Factory</item>
                    <item name="package" xsi:type="string">symfony/ai-generic-platform</item>
                    <item name="dialect" xsi:type="string">openai_chat</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!-- How each request-option dialect spells the options every provider has. Verified against the
         bridge packages at symfony/ai-platform 0.12: options are merged into the provider's request
         body nearly untouched, and OpenAI-compatible endpoints reject unknown body fields with a
         400, so a wrong name is a hard failure rather than a no-op.

         `lists` names the options a provider wants as an array of strings, so a caller can pass a
         single stop sequence everywhere. `defaults` covers a provider that requires an option the
         others default themselves: Anthropic's Messages API rejects a request without max_tokens,
         which would make the same call fail on Anthropic alone. 4096 is below every current Claude
         model's output ceiling; raise it per request when a longer answer is wanted.

         An option absent from a dialect's `map` is not supported by that provider and raises an
         error naming both, rather than being dropped on the way to the wire.

         `values` covers `tool_choice` and `reasoning_effort`: a provider's own vocabulary for these
         differs by value, not only by field name (Anthropic's "required" is "any"), and a single
         value can spread across more than one target field (Anthropic's reasoning_effort sets both
         `thinking` and `output_config`), so each canonical value maps to the request fragment it
         becomes rather than to one renamed key. `{{name}}` inside a fragment is replaced with the
         tool name when the caller forces one specific tool. Only symfony/ai-open-ai-platform is
         installed in this repo's dev dependencies, so the OpenAI/Azure Responses shape below is
         exercised by tests; the Anthropic, Gemini and Ollama shapes follow each provider's public
         API docs and want confirming against a live call before the accepted values are treated as
         final, especially Gemini's `thinkingConfig` token-budget tiers, which are this module's own
         choice of thresholds rather than something the API prescribes. -->
    <type name="MageOS\AiBase\Model\Client\OptionNormalizer">
        <arguments>
            <argument name="dialects" xsi:type="array">
                <item name="openai_chat" xsi:type="array">
                    <item name="map" xsi:type="array">
                        <item name="max_tokens" xsi:type="string">max_tokens</item>
                        <item name="temperature" xsi:type="string">temperature</item>
                        <item name="top_p" xsi:type="string">top_p</item>
                        <item name="stop" xsi:type="string">stop</item>
                    </item>
                    <item name="values" xsi:type="array">
                        <item name="tool_choice" xsi:type="array">
                            <item name="auto" xsi:type="array">
                                <item name="tool_choice" xsi:type="string">auto</item>
                            </item>
                            <item name="none" xsi:type="array">
                                <item name="tool_choice" xsi:type="string">none</item>
                            </item>
                            <item name="required" xsi:type="array">
                                <item name="tool_choice" xsi:type="string">required</item>
                            </item>
                            <item name="tool" xsi:type="array">
                                <item name="tool_choice" xsi:type="array">
                                    <item name="type" xsi:type="string">function</item>
                                    <item name="function" xsi:type="array">
                                        <item name="name" xsi:type="string">{{name}}</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                        <item name="reasoning_effort" xsi:type="array">
                            <item name="none" xsi:type="array">
                                <item name="reasoning_effort" xsi:type="string">none</item>
                            </item>
                            <item name="low" xsi:type="array">
                                <item name="reasoning_effort" xsi:type="string">low</item>
                            </item>
                            <item name="medium" xsi:type="array">
                                <item name="reasoning_effort" xsi:type="string">medium</item>
                            </item>
                            <item name="high" xsi:type="array">
                                <item name="reasoning_effort" xsi:type="string">high</item>
                            </item>
                        </item>
                    </item>
                </item>
                <!-- The Responses API, which the OpenAI and Azure bridges both target. It renamed
                     max_tokens to max_output_tokens and has no stop-sequence parameter at all. -->
                <item name="openai_responses" xsi:type="array">
                    <item name="map" xsi:type="array">
                        <item name="max_tokens" xsi:type="string">max_output_tokens</item>
                        <item name="temperature" xsi:type="string">temperature</item>
                        <item name="top_p" xsi:type="string">top_p</item>
                    </item>
                    <item name="values" xsi:type="array">
                        <item name="tool_choice" xsi:type="array">
                            <item name="auto" xsi:type="array">
                                <item name="tool_choice" xsi:type="string">auto</item>
                            </item>
                            <item name="none" xsi:type="array">
                                <item name="tool_choice" xsi:type="string">none</item>
                            </item>
                            <item name="required" xsi:type="array">
                                <item name="tool_choice" xsi:type="string">required</item>
                            </item>
                            <item name="tool" xsi:type="array">
                                <item name="tool_choice" xsi:type="array">
                                    <item name="type" xsi:type="string">function</item>
                                    <item name="name" xsi:type="string">{{name}}</item>
                                </item>
                            </item>
                        </item>
                        <!-- The Responses API's `reasoning.effort` has no "none" tier of its own;
                             "minimal" is the lowest it accepts, so that is what the neutral "none"
                             becomes here. -->
                        <item name="reasoning_effort" xsi:type="array">
                            <item name="none" xsi:type="array">
                                <item name="reasoning" xsi:type="array">
                                    <item name="effort" xsi:type="string">minimal</item>
                                </item>
                            </item>
                            <item name="low" xsi:type="array">
                                <item name="reasoning" xsi:type="array">
                                    <item name="effort" xsi:type="string">low</item>
                                </item>
                            </item>
                            <item name="medium" xsi:type="array">
                                <item name="reasoning" xsi:type="array">
                                    <item name="effort" xsi:type="string">medium</item>
                                </item>
                            </item>
                            <item name="high" xsi:type="array">
                                <item name="reasoning" xsi:type="array">
                                    <item name="effort" xsi:type="string">high</item>
                                </item>
                            </item>
                        </item>
                    </item>
                </item>
                <item name="anthropic_messages" xsi:type="array">
                    <item name="map" xsi:type="array">
                        <item name="max_tokens" xsi:type="string">max_tokens</item>
                        <item name="temperature" xsi:type="string">temperature</item>
                        <item name="top_p" xsi:type="string">top_p</item>
                        <item name="stop" xsi:type="string">stop_sequences</item>
                    </item>
                    <item name="lists" xsi:type="array">
                        <item name="stop" xsi:type="string">stop</item>
                    </item>
                    <item name="defaults" xsi:type="array">
                        <item name="max_tokens" xsi:type="number">4096</item>
                    </item>
                    <!-- Anthropic has no "required": "any" is its own name for "call some tool".
                         reasoning_effort spreads across two fields: `thinking.type` switches
                         extended thinking on or off, and `output_config.effort` only means anything
                         once it is on, so "none" leaves it out entirely.

                         Two of these are model-dependent (see docs/PROVIDERS.md, "Model-dependent
                         values"): models whose thinking is always on reject "disabled", and some
                         recent models reject a forced tool choice ("any" or "tool"). -->
                    <item name="values" xsi:type="array">
                        <item name="tool_choice" xsi:type="array">
                            <item name="auto" xsi:type="array">
                                <item name="tool_choice" xsi:type="array">
                                    <item name="type" xsi:type="string">auto</item>
                                </item>
                            </item>
                            <item name="none" xsi:type="array">
                                <item name="tool_choice" xsi:type="array">
                                    <item name="type" xsi:type="string">none</item>
                                </item>
                            </item>
                            <item name="required" xsi:type="array">
                                <item name="tool_choice" xsi:type="array">
                                    <item name="type" xsi:type="string">any</item>
                                </item>
                            </item>
                            <item name="tool" xsi:type="array">
                                <item name="tool_choice" xsi:type="array">
                                    <item name="type" xsi:type="string">tool</item>
                                    <item name="name" xsi:type="string">{{name}}</item>
                                </item>
                            </item>
                        </item>
                        <item name="reasoning_effort" xsi:type="array">
                            <item name="none" xsi:type="array">
                                <item name="thinking" xsi:type="array">
                                    <item name="type" xsi:type="string">disabled</item>
                                </item>
                            </item>
                            <item name="low" xsi:type="array">
                                <item name="thinking" xsi:type="array">
                                    <item name="type" xsi:type="string">adaptive</item>
                                </item>
                                <item name="output_config" xsi:type="array">
                                    <item name="effort" xsi:type="string">low</item>
                                </item>
                            </item>
                            <item name="medium" xsi:type="array">
                                <item name="thinking" xsi:type="array">
                                    <item name="type" xsi:type="string">adaptive</item>
                                </item>
                                <item name="output_config" xsi:type="array">
                                    <item name="effort" xsi:type="string">medium</item>
                                </item>
                            </item>
                            <item name="high" xsi:type="array">
                                <item name="thinking" xsi:type="array">
                                    <item name="type" xsi:type="string">adaptive</item>
                                </item>
                                <item name="output_config" xsi:type="array">
                                    <item name="effort" xsi:type="string">high</item>
                                </item>
                            </item>
                        </item>
                    </item>
                </item>
                <!-- Gemini nests these under generationConfig and spells them in camelCase. -->
                <item name="gemini" xsi:type="array">
                    <item name="map" xsi:type="array">
                        <item name="max_tokens" xsi:type="string">maxOutputTokens</item>
                        <item name="temperature" xsi:type="string">temperature</item>
                        <item name="top_p" xsi:type="string">topP</item>
                        <item name="stop" xsi:type="string">stopSequences</item>
                    </item>
                    <item name="lists" xsi:type="array">
                        <item name="stop" xsi:type="string">stop</item>
                    </item>
                    <!-- Gemini's tool choice is `toolConfig.functionCallingConfig.mode`, with
                         `allowedFunctionNames` narrowing which tool "ANY" is allowed to be. Its
                         thinking control has no effort levels of its own, only a token budget
                         (`thinkingConfig.thinkingBudget`); the tiers below are this module's own
                         choice, not a value Google's API defines. The budget is per model: 2.5
                         Flash accepts 0 to switch thinking off, 2.5 Pro enforces a minimum and
                         rejects it, and newer models take a named thinking level rather than a
                         budget (see docs/PROVIDERS.md, "Model-dependent values"). -->
                    <item name="values" xsi:type="array">
                        <item name="tool_choice" xsi:type="array">
                            <item name="auto" xsi:type="array">
                                <item name="toolConfig" xsi:type="array">
                                    <item name="functionCallingConfig" xsi:type="array">
                                        <item name="mode" xsi:type="string">AUTO</item>
                                    </item>
                                </item>
                            </item>
                            <item name="none" xsi:type="array">
                                <item name="toolConfig" xsi:type="array">
                                    <item name="functionCallingConfig" xsi:type="array">
                                        <item name="mode" xsi:type="string">NONE</item>
                                    </item>
                                </item>
                            </item>
                            <item name="required" xsi:type="array">
                                <item name="toolConfig" xsi:type="array">
                                    <item name="functionCallingConfig" xsi:type="array">
                                        <item name="mode" xsi:type="string">ANY</item>
                                    </item>
                                </item>
                            </item>
                            <item name="tool" xsi:type="array">
                                <item name="toolConfig" xsi:type="array">
                                    <item name="functionCallingConfig" xsi:type="array">
                                        <item name="mode" xsi:type="string">ANY</item>
                                        <item name="allowedFunctionNames" xsi:type="array">
                                            <item name="0" xsi:type="string">{{name}}</item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                        <item name="reasoning_effort" xsi:type="array">
                            <item name="none" xsi:type="array">
                                <item name="thinkingConfig" xsi:type="array">
                                    <item name="thinkingBudget" xsi:type="number">0</item>
                                </item>
                            </item>
                            <item name="low" xsi:type="array">
                                <item name="thinkingConfig" xsi:type="array">
                                    <item name="thinkingBudget" xsi:type="number">1024</item>
                                </item>
                            </item>
                            <item name="medium" xsi:type="array">
                                <item name="thinkingConfig" xsi:type="array">
                                    <item name="thinkingBudget" xsi:type="number">8192</item>
                                </item>
                            </item>
                            <item name="high" xsi:type="array">
                                <item name="thinkingConfig" xsi:type="array">
                                    <item name="thinkingBudget" xsi:type="number">24576</item>
                                </item>
                            </item>
                        </item>
                    </item>
                </item>
                <!-- Ollama's bridge moves everything it does not recognise as a top-level key into
                     the nested `options` object for us, so only the name has to change. It has no
                     tool-choice concept at all, so that canonical option is left out of `values`
                     entirely: "auto" stays a no-op, anything else is refused. Its reasoning control
                     is the `think` field: a plain `false` for "none", the level name otherwise. -->
                <item name="ollama" xsi:type="array">
                    <item name="map" xsi:type="array">
                        <item name="max_tokens" xsi:type="string">num_predict</item>
                        <item name="temperature" xsi:type="string">temperature</item>
                        <item name="top_p" xsi:type="string">top_p</item>
                        <item name="stop" xsi:type="string">stop</item>
                    </item>
                    <item name="lists" xsi:type="array">
                        <item name="stop" xsi:type="string">stop</item>
                    </item>
                    <item name="values" xsi:type="array">
                        <item name="reasoning_effort" xsi:type="array">
                            <item name="none" xsi:type="array">
                                <item name="think" xsi:type="boolean">false</item>
                            </item>
                            <item name="low" xsi:type="array">
                                <item name="think" xsi:type="string">low</item>
                            </item>
                            <item name="medium" xsi:type="array">
                                <item name="think" xsi:type="string">medium</item>
                            </item>
                            <item name="high" xsi:type="array">
                                <item name="think" xsi:type="string">high</item>
                            </item>
                        </item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Wires the raw usage listing's data source (task 015): the ui_component declares the
         generic Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider directly
         instead of a bespoke PHP data provider class, which needs
         Magento\Framework\View\Element\UiComponent\DataProvider\Reporting to resolve the
         listing's dataProvider name to a collection through this factory's `collections` array.
         That collection has to implement Api\Search\SearchResultInterface, which the raw
         Collection class (task 005) does not and must not: it stays a plain
         Magento\Framework\Model\ResourceModel\Db\Collection\AbstractCollection for
         UsageRecordRepository, the only other caller. Magento_UrlRewrite's own
         url_rewrite_listing_data_source wiring is the model this follows: point the factory at a
         virtualType of the framework's own SearchResult (also an AbstractCollection, but one
         that implements SearchResultInterface), configured with this table rather than reusing
         either PHP model class. -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="mageos_ai_usage_listing_data_source" xsi:type="string">MageOS\AiBase\Model\ResourceModel\Usage\UsageLog\SearchResult</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="MageOS\AiBase\Model\ResourceModel\Usage\UsageLog\SearchResult"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">mageos_ai_usage_log</argument>
            <argument name="resourceModel" xsi:type="string">MageOS\AiBase\Model\ResourceModel\Usage\UsageLog</argument>
            <argument name="identifierName" xsi:type="string">entity_id</argument>
        </arguments>
    </virtualType>

    <!-- The module's first console command (task 018): `bin/magento mageos:ai:usage` prints the
         same totals and per-consumer breakdown the admin usage dashboard shows, through
         UsageStatsInterface, for merchants and support who work from the shell. -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="mageos_ai_usage_report" xsi:type="object">MageOS\AiBase\Console\Command\UsageReport</item>
            </argument>
        </arguments>
    </type>
</config>
