<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>
        <!--
            Mage-OS ships no configuration tab of its own, and the modules around this one each
            landed somewhere different: the catalog tab, an existing section, or a tab a single
            module invented. This is the base AI module, so it declares the shared one for the
            ecosystem to settle on. The class is what carries the logo, styled in services.less.

            sortOrder 250 sits between Catalog (200) and Customers (300), beside where other
            vendor tabs land, and collides with none of the core tabs.
        -->
        <tab id="mageos" translate="label" sortOrder="250" class="mageos-tab">
            <label>Mage-OS</label>
        </tab>

        <section id="mageos_ai" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>AI Configuration</label>
            <tab>mageos</tab>
            <resource>MageOS_AiBase::configuration</resource>

            <group id="services" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Services</label>
                <attribute type="expanded">1</attribute>
                <field id="configuration" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Configured Services</label>
                    <backend_model>MageOS\AiBase\Model\Config\Backend\EncryptedServices</backend_model>
                    <!--
                        No comment element here. Magento renders one under the whole control, which
                        is the wrong place for guidance about the provider buttons, and it cannot
                        vary with the application mode. The template says it beside the buttons.
                    -->
                    <frontend_model>MageOS\AiBase\Block\Adminhtml\Configuration\Services</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
