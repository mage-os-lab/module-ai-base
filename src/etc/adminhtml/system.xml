<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>
        <!--
            Mage-OS ships no configuration tab of its own, and the modules around this one each
            landed somewhere different: the catalog tab, an existing section, or a tab a single
            module invented. This is the base AI module, so it declares the shared one for the
            ecosystem to settle on. The class is what carries the logo, styled in services.less.

            sortOrder 250 sits between Catalog (200) and Customers (300), beside where other
            vendor tabs land, and collides with none of the core tabs.
        -->
        <tab id="mageos" translate="label" sortOrder="250" class="mageos-tab">
            <label>Mage-OS</label>
        </tab>

        <section id="mageos_ai" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>AI Configuration</label>
            <tab>mageos</tab>
            <resource>MageOS_AiBase::configuration</resource>

            <group id="services" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Services</label>
                <attribute type="expanded">1</attribute>
                <field id="configuration" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Configured Services</label>
                    <backend_model>MageOS\AiBase\Model\Config\Backend\EncryptedServices</backend_model>
                    <!--
                        No comment element here. Magento renders one under the whole control, which
                        is the wrong place for guidance about the provider buttons, and it cannot
                        vary with the application mode. The template says it beside the buttons.
                    -->
                    <frontend_model>MageOS\AiBase\Block\Adminhtml\Configuration\Services</frontend_model>
                </field>
            </group>

            <!--
                Every field here is showInDefault only: retention and the cron schedule are read
                by the cleanup job and the CLI, neither of which has a website or store in play
                (see UsageConfig), so a store-level override would be a field that silently does
                nothing. The toggle is default-scope for the same reason: the recording decorator
                that reads it runs from the chat controller with whatever store is ambient, but a
                per-store opt-out is not a feature this task adds.
            -->
            <group id="usage" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>Usage Tracking</label>
                <field id="report_link" translate="label" type="button" sortOrder="5" showInDefault="1">
                    <label>Report</label>
                    <!--
                        Not a setting: a link to Reports > AI Token Usage, rendered by a block
                        because an admin URL needs the session's secret key. Hidden from a role
                        the report's own ACL would refuse.
                    -->
                    <frontend_model>MageOS\AiBase\Block\Adminhtml\Configuration\UsageReportLink</frontend_model>
                </field>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enable Usage Tracking</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="retention_days" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Raw Usage Retention (Days)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="daily_retention_days" translate="label" type="text" sortOrder="30" showInDefault="1">
                    <label>Daily Usage Retention (Days)</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="cron_expr" translate="label comment" type="text" sortOrder="40" showInDefault="1"
                       canRestore="1">
                    <label>Cleanup Cron Schedule</label>
                    <backend_model>MageOS\AiBase\Model\Config\Backend\CronExpression</backend_model>
                    <comment><![CDATA[Five cron fields, for example <code>0 3 * * *</code> for daily at 03:00. Leave empty to never schedule the cleanup.]]></comment>
                    <!--
                        Read by Magento's own cron scheduler through the config_path in
                        crontab.xml, not by UsageConfig: see that class for why the retention
                        fields are read here and this one is not.
                    -->
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
