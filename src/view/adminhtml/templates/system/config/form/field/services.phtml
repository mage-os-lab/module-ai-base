    </div>
    <input type="hidden"
           name="<?= $escaper->escapeHtmlAttr($block->getElement()->getName()) ?>[__empty]"
           value=""/>

    <?php
    $schemaJson = $block->getServicesSchemaJson();
    $fieldNameJs = $escaper->escapeJs($block->getElement()->getName());
    $deleteLabelJs = $escaper->escapeJs(__('Delete'));
    $nameLabelJs = $escaper->escapeJs(__('Name'));
    $renameLabelJs = $escaper->escapeJs(__('Rename this service'));
    $enabledLabelJs = $escaper->escapeJs(__('Enabled'));
    $disabledNoteJs = $escaper->escapeJs(__('Disabled, nothing will use this service'));
    // Reserved configuration key, not a provider field, shared with the API constant.
    $enabledKeyJs = $escaper->escapeJs(\MageOS\AiBase\Api\Data\AiServiceInterface::CONFIGURATION_ENABLED);
    // Reserved configuration key, not a provider field. Kept in one place so the form, the option
    // source consumers point their own system.xml at, and the API constant cannot drift apart.
    $labelKeyJs = $escaper->escapeJs(\MageOS\AiBase\Api\Data\AiServiceInterface::CONFIGURATION_LABEL);
    // Removing a row discards a credential the administrator cannot read back and cannot retype.
    $deleteConfirmJs = $escaper->escapeJs(
        __('Remove this service? Its saved credentials are deleted when you save the configuration.')
    );
    $htmlIdJs = $escaper->escapeJs($_htmlId);
    // A locked field is skipped by the save path, so every control that edits one edits nothing.
    // The rows themselves stay, and so do the two actions that read stored configuration rather
    // than change it, since they are the only way to check what a locked install is actually using.
    $readOnlyJs = $_isReadOnly ? 'true' : 'false';
    // Test Connection is only rendered for SAVED rows: the client factory reads
    // saved configuration, so unsaved rows cannot be tested. When multiple rows
    // share a service code, the factory uses the FIRST configured row of that
    // code, so results are effectively per-code, not per-row.
    $testUrlJs = $escaper->escapeJs($block->getUrl('mageos_ai/service/test'));
    $testLabelJs = $escaper->escapeJs(__('Test Connection'));
    $testingLabelJs = $escaper->escapeJs(__('Testing...'));
    // Refresh Models mirrors Test Connection: saved rows only, first configured row per
    // code; the button is rendered only for services whose schema opts in.
    $refreshUrlJs = $escaper->escapeJs($block->getUrl('mageos_ai/service/refreshmodels'));
    $refreshLabelJs = $escaper->escapeJs(__('Refresh Models'));
    $refreshingLabelJs = $escaper->escapeJs(__('Refreshing...'));
    $modelsLabelJs = $escaper->escapeJs(__('models'));
    $existingRowsJs = '';
    foreach ($block->getArrayRows() as $_row) {
        $rowData = $_row->getData();
        $serviceCode = array_key_first($rowData);
        $existingRowsJs .= sprintf(
            "    addRow('%s', %s, '%s');\n",
            $escaper->escapeJs($serviceCode),
            json_encode($rowData[$serviceCode]),
            $escaper->escapeJs((string) $_row->getData('_id'))
        );
    }
    $scriptString = <<<script
require(['prototype'], function () {
    const schema = {$schemaJson};
    const fieldNameBase = '{$fieldNameJs}';
    const readOnly = {$readOnlyJs};
    const disabledAttr = readOnly ? ' disabled' : '';

    function escapeHtml(value) {
        if (value === null || value === undefined) return '';
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    let datalistSequence = 0;
    let fieldSequence = 0;

    function buildOptions(options, selectedValue) {
        return options.map(function (opt) {
            const selected = (selectedValue !== undefined && selectedValue === opt.value) ? ' selected' : '';
            return '<option value="' + escapeHtml(opt.value) + '"' + selected + '>'
                + escapeHtml(opt.label) + '</option>';
        }).join('');
    }

    /**
     * Find a row's input by its exact name attribute.
     *
     * Row IDs, service codes and field names all originate as POST array keys and reach
     * the browser unmodified, so interpolating them into a selector string lets a stored
     * value containing a double quote produce an invalid selector. querySelector then
     * throws a SyntaxError, which aborts whatever loop is calling it and leaves the form
     * half-rendered. Comparing the name attribute in JavaScript keeps untrusted text away
     * from the selector parser entirely; the only selector used here is a constant.
     */
    function findField(rowId, serviceCode, fieldName) {
        const container = document.querySelector('.ai-services-configurator');
        if (!container) return null;

        const name = fieldNameBase + '[' + rowId + '][' + serviceCode + '][' + fieldName + ']';

        return Array.from(container.querySelectorAll('[name]')).find(function (el) {
            return el.getAttribute('name') === name;
        }) || null;
    }

    /**
     * Every control gets an id so its <th> can be a real <label for>. The id is keyed off a
     * sequence rather than the row ID for the same reason the datalist id is: row IDs are
     * attacker controllable, and this keeps them out of the attribute entirely.
     */
    function buildField(serviceCode, fieldName, field) {
        const base = fieldNameBase + '[' + fieldName + '][' + serviceCode + '][' + field.name + ']';
        const fieldId = 'ai-field-' + (++fieldSequence);

        if (field.type === 'select') {
            return {
                id: fieldId,
                html: '<select id="' + fieldId + '" name="' + escapeHtml(base) + '"' + disabledAttr + '>'
                    + buildOptions(field.options, field.default) + '</select>',
            };
        }
        const defaultAttr = field.default ? ' value="' + escapeHtml(field.default) + '"' : '';
        const inputType = (field.type === 'password' || field.type === 'text') ? field.type : 'text';
        const type = field.encrypted ? 'password' : inputType;
        // Credentials are not the administrator's own password. Without this a password manager
        // offers to save the provider's API key as a login for the store's admin domain, and
        // offers it back on the next unrelated password field.
        const autocomplete = ' autocomplete="off" spellcheck="false"';

        // A free-text field carrying options (the model field) gets them as datalist
        // suggestions, so a refreshed list is usable without constraining the input to it.
        if (field.options && field.options.length && type !== 'password') {
            const listId = 'ai-model-options-' + (++datalistSequence);
            return {
                id: fieldId,
                html: '<input type="' + type + '" id="' + fieldId + '" name="' + escapeHtml(base) + '"'
                    + defaultAttr + autocomplete + disabledAttr + ' list="' + listId + '"/>'
                    + '<datalist id="' + listId + '">' + buildOptions(field.options) + '</datalist>',
            };
        }

        return {
            id: fieldId,
            html: '<input type="' + type + '" id="' + fieldId + '" name="' + escapeHtml(base) + '"'
                + defaultAttr + autocomplete + disabledAttr + '/>',
        };
    }

    function addRow(serviceCode, values, existingRowId) {
        const serviceSchema = schema[serviceCode];
        if (!serviceSchema) return;
        const fields = serviceSchema.fields;

        const d = new Date();
        const rowId = existingRowId || ('_' + d.getTime() + '_' + d.getMilliseconds());
        const serviceName = serviceSchema.name || serviceCode;
        const isEnabled = !values || values['{$enabledKeyJs}'] === undefined
            || String(values['{$enabledKeyJs}']) !== '0';

        // The refresh control sits with the model field it refills rather than in the action
        // column: it acts on that one control, and as an icon beside it that is self-evident,
        // where a second full-width button under Test Connection was not. Saved rows only, since
        // the fetch uses stored credentials.
        const canRefresh = Boolean(existingRowId) && Boolean(serviceSchema.supportsModelRefresh);

        // Naming a row is the exception, not the routine, so the field stays out of the way until
        // the pencil beside the heading asks for it. The heading already shows the name that is
        // set, so nothing is hidden that an administrator cannot see.
        const nameControlId = 'ai-field-' + (++fieldSequence);
        const nameField = fieldNameBase + '[' + rowId + '][' + serviceCode + '][{$labelKeyJs}]';
        const nameRow = '<tr class="ai-service-name-row" hidden'
            + ' data-row-name-row="' + escapeHtml(rowId) + '">'
            + '<th><label for="' + nameControlId + '">{$nameLabelJs}</label></th>'
            + '<td><div class="ai-field-control">'
            + '<input type="text" id="' + nameControlId + '" name="' + escapeHtml(nameField) + '"'
            + ' autocomplete="off" data-row-label="' + escapeHtml(rowId) + '"' + disabledAttr
            + ' placeholder="' + escapeHtml(serviceName) + '"/>'
            + '</div></td>'
            + '</tr>';

        const rows = nameRow + fields.map(function (field) {
            const control = buildField(serviceCode, rowId, field);
            const refresh = (canRefresh && field.name === 'model')
                ? '<button type="button" class="ai-refresh-models action-refresh-models"'
                    + ' data-service-code="' + escapeHtml(serviceCode) + '"'
                    + ' data-row-id="' + escapeHtml(rowId) + '"'
                    + ' title="{$refreshLabelJs}" aria-label="{$refreshLabelJs}">'
                    + '<span class="ai-refresh-models-icon" aria-hidden="true">&#8635;</span>'
                    + '<span class="ai-refresh-models-label">{$refreshLabelJs}</span>'
                    + '</button>'
                : '';

            return '<tr>'
                + '<th><label for="' + control.id + '">' + escapeHtml(field.label) + '</label></th>'
                + '<td><div class="ai-field-control">' + control.html + refresh + '</div></td>'
                + '</tr>';
        }).join('');

        // Stored rows (they arrive with an existingRowId) get a Test Connection
        // button; unsaved rows cannot be tested because the client factory only
        // reads saved configuration. The button carries the row id, so it acts on
        // the row it sits in rather than on the first row of the same service code.
        const testHtml = existingRowId
            ? '<button class="action-test-connection ai-service-row-action" type="button"'
                + ' data-service-code="' + escapeHtml(serviceCode) + '"'
                + ' data-row-id="' + escapeHtml(rowId) + '">'
                + '<span>{$testLabelJs}</span></button>'
            : '';

        // Both row actions sit on one line, level with the row's heading, and at a size that
        // matches the refresh control beside the model field. Test Connection as a full-width
        // pill made the action column the loudest thing in a row that is mostly inputs.
        const deleteHtml = readOnly ? '' : '<button class="action-delete ai-service-row-action" type="button"'
            + ' data-row-id="' + escapeHtml(rowId) + '"'
            + ' title="{$deleteLabelJs}" aria-label="{$deleteLabelJs} ' + escapeHtml(serviceName) + '">'
            + '<span class="ai-service-row-action-label">{$deleteLabelJs}</span></button>';

        // The actions live in the heading rather than in a column of their own. A column sized for
        // "Test Connection" took a third of the row's width away from the fields that are the
        // point of it, on every row, whether or not the buttons were ever used.
        const actionsHtml = '<div class="ai-service-row-actions">' + testHtml + deleteHtml + '</div>';

        // Which provider a row configures is the one thing its fields never say, and two rows of
        // the same backend (two accounts, two billing owners) are otherwise indistinguishable.
        // The model rides along as a subtitle because it is what tells those two rows apart.
        // An unchecked checkbox posts nothing, so the hidden input carries the "off" value and the
        // checkbox overwrites it when ticked. Without it, disabling a row would be indistinguishable
        // from a row saved before this setting existed, which has to keep meaning enabled.
        const enabledField = fieldNameBase + '[' + rowId + '][' + serviceCode + '][{$enabledKeyJs}]';
        const enabledHtml = '<label class="ai-service-toggle" title="{$enabledLabelJs}">'
            + '<input type="hidden" name="' + escapeHtml(enabledField) + '" value="0"' + disabledAttr + '/>'
            + '<input type="checkbox" class="ai-service-toggle-input"'
            + ' name="' + escapeHtml(enabledField) + '" value="1"' + disabledAttr
            + ' data-row-enabled="' + escapeHtml(rowId) + '"' + (isEnabled ? ' checked' : '') + '/>'
            + '<span class="ai-service-toggle-label">{$enabledLabelJs}</span>'
            + '</label>';

        const renameHtml = readOnly ? '' : '<button type="button" class="ai-service-rename"'
            + ' data-row-rename="' + escapeHtml(rowId) + '" aria-expanded="false"'
            + ' title="{$renameLabelJs}" aria-label="{$renameLabelJs}">'
            + '<span class="ai-service-rename-icon" aria-hidden="true">&#9998;</span>'
            + '<span class="ai-service-row-action-label">{$renameLabelJs}</span>'
            + '</button>';

        const headingHtml = '<div class="ai-service-row-heading">'
            + enabledHtml
            + '<span class="ai-service-row-name" data-row-heading="' + escapeHtml(rowId) + '">'
            + escapeHtml(serviceName) + '</span>'
            + renameHtml
            + '<span class="ai-service-row-model" data-row-model="' + escapeHtml(rowId) + '"></span>'
            + actionsHtml
            + '</div>';

        const rowHtml = '<tr id="' + escapeHtml(rowId) + '">'
            + '<td>' + headingHtml
            + '<table class="ai-service-row-fields">' + rows + '</table>'
            + '<div class="ai-test-result" role="status" aria-live="polite"></div></td>'
            + '</tr>';

        Element.insert($('addRow{$htmlIdJs}'), { bottom: rowHtml });
        syncRowModel(rowId, serviceCode);
        syncRowHeading(rowId, serviceCode, serviceName);
        syncRowEnabled(rowId);

        if (values) {
            Object.keys(values).forEach(function (key) {
                // The enable toggle is a checkbox with a hidden input of the same name carrying the
                // "off" value, and findField() answers with the first match, which is the hidden
                // one. Restoring the stored value into it would overwrite that "off" with the
                // stored "on", and unchecking a saved row would post enabled and do nothing.
                // The checkbox already renders from this value, so there is nothing to restore.
                if (key === '{$enabledKeyJs}') return;

                const el = findField(rowId, serviceCode, key);
                if (!el) return;
                if (el.tagName === 'SELECT') {
                    const hasOption = Array.from(el.options).some(function (opt) {
                        return opt.value === values[key];
                    });
                    if (!hasOption && values[key] !== undefined && values[key] !== null && values[key] !== '') {
                        const legacyOpt = document.createElement('option');
                        legacyOpt.value = values[key];
                        legacyOpt.text = values[key] + ' (legacy)';
                        el.insertBefore(legacyOpt, el.firstChild);
                    }
                }
                el.value = values[key];
            });
            syncRowModel(rowId, serviceCode);
            syncRowHeading(rowId, serviceCode, serviceName);
        }

        return rowId;
    }

    /**
     * Keep the row's subtitle showing the model that row is set to, since that is what tells two
     * rows of the same provider apart once both are collapsed into a wall of identical fields.
     */
    /**
     * The subtitle element of a row, found by comparing its attribute rather than by building a
     * selector out of the row ID, for the same reason findField() does: a stored ID containing a
     * double quote makes querySelector throw and aborts the loop that called it.
     */
    function findRowModelLabel(rowId) {
        return findByAttribute('data-row-model', rowId);
    }

    function syncRowModel(rowId, serviceCode) {
        const label = findRowModelLabel(rowId);
        const field = findField(rowId, serviceCode, 'model');
        if (!label) return;
        label.textContent = (field && field.value) ? field.value : '';
        if (field && !field.dataset.modelSynced) {
            field.dataset.modelSynced = '1';
            field.addEventListener('change', function () { syncRowModel(rowId, serviceCode); });
            field.addEventListener('input', function () { syncRowModel(rowId, serviceCode); });
        }
    }

    /**
     * Lead the row's heading with the name an administrator gave it, and keep the provider behind
     * it: a row called "Chat AI" still has to say which backend it bills.
     */
    function syncRowHeading(rowId, serviceCode, serviceName) {
        const heading = findByAttribute('data-row-heading', rowId);
        const field = findByAttribute('data-row-label', rowId);
        if (!heading) return;

        const typed = field ? field.value.trim() : '';
        heading.textContent = typed === '' ? serviceName : typed + ' \u00b7 ' + serviceName;

        if (field && !field.dataset.headingSynced) {
            field.dataset.headingSynced = '1';
            field.addEventListener('input', function () {
                syncRowHeading(rowId, serviceCode, serviceName);
            });
        }
    }

    /**
     * Elements are matched on an attribute rather than through a selector built from the row ID,
     * for the reason findField() gives: a stored ID containing a double quote makes querySelector
     * throw and aborts the loop that called it. The selector stays a literal for the same reason,
     * so nothing this function is called with can reach the selector parser.
     */
    function findByAttribute(attribute, value) {
        const container = document.querySelector('.ai-services-configurator');
        if (!container) return null;

        const candidates = container.querySelectorAll(
            '[data-row-heading], [data-row-label], [data-row-model], [data-row-name-row], [data-row-enabled]'
        );

        return Array.from(candidates).find(function (el) {
            return el.getAttribute(attribute) === value;
        }) || null;
    }

    /**
     * Reflect the toggle in the row itself: a disabled service is not called by anything, so the
     * controls that call one are switched off with it rather than left to fail on click.
     */
    function syncRowEnabled(rowId) {
        const toggle = findByAttribute('data-row-enabled', rowId);
        const row = document.getElementById(rowId);
        if (!toggle || !row) return;

        const enabled = toggle.checked;
        row.classList.toggle('ai-service-row-disabled', !enabled);
        row.querySelectorAll('.action-test-connection, .ai-refresh-models').forEach(function (button) {
            button.disabled = !enabled;
            button.title = enabled ? button.dataset.enabledTitle || button.title : '{$disabledNoteJs}';
        });

        if (!toggle.dataset.enabledSynced) {
            toggle.dataset.enabledSynced = '1';
            row.querySelectorAll('.action-test-connection, .ai-refresh-models').forEach(function (button) {
                button.dataset.enabledTitle = button.title;
            });
            toggle.addEventListener('change', function () { syncRowEnabled(rowId); });
        }
    }

    function updateEmptyState() {
        const body = document.getElementById('addRow{$htmlIdJs}');
        const emptyState = document.querySelector('.ai-services-empty-state');
        if (body && emptyState) {
            emptyState.hidden = body.querySelectorAll('tr').length > 0;
        }
    }

    document.querySelectorAll('.ai-services-configurator .add-ai-service').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            const trigger = e.target.closest('.add-ai-service');
            const rowId = addRow(trigger.dataset.aiService);
            updateEmptyState();
            // Land the caret in the row's first field, so adding a provider continues into filling
            // it in. Scoped to the field table on purpose: the heading carries the enable toggle
            // and the rename pencil, and the toggle is the first focusable control in the row, so
            // an unscoped search would put the caret on it and the next Space would switch the row
            // straight back off. The name field is skipped by the visibility test, since it stays
            // hidden until the pencil asks for it and focusing a hidden input does nothing.
            const newRow = document.getElementById(rowId);
            const fieldControls = newRow
                ? newRow.querySelectorAll('.ai-service-row-fields input, .ai-service-row-fields select')
                : [];
            const firstField = Array.from(fieldControls).find(function (el) {
                return el.offsetParent !== null;
            });
            if (firstField) firstField.focus();
        });
    });

    /**
     * The result element of the row a button belongs to. It lives beside the fields rather than in
     * the action column, where a provider's error message wrapped to five lines in 260 pixels.
     */
    function resultElementFor(button) {
        const row = button.closest('tr[id]');
        return row ? row.querySelector('.ai-test-result') : null;
    }

    function testConnection(button) {
        const resultEl = resultElementFor(button);
        if (!resultEl) return;
        button.disabled = true;
        resultEl.className = 'ai-test-result';
        resultEl.textContent = '{$testingLabelJs}';

        const body = new URLSearchParams();
        body.append('service_id', button.dataset.rowId);
        body.append('service_code', button.dataset.serviceCode);
        body.append('form_key', window.FORM_KEY);

        fetch('{$testUrlJs}', { method: 'POST', body: body })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (data.success) {
                    resultEl.classList.add('ai-test-result-success');
                    resultEl.textContent = 'OK (' + data.latency_ms + 'ms): ' + data.response;
                } else {
                    resultEl.classList.add('ai-test-result-error');
                    resultEl.textContent = data.error;
                }
            })
            .catch(function (error) {
                resultEl.classList.add('ai-test-result-error');
                resultEl.textContent = String(error);
            })
            .finally(function () {
                button.disabled = false;
            });
    }

    function updateModelOptions(rowId, serviceCode, models) {
        const el = findField(rowId, serviceCode, 'model');
        if (!el) return;

        if (el.tagName !== 'SELECT') {
            updateModelDatalist(el, models);
            return;
        }

        const current = el.value;
        while (el.options.length) {
            el.remove(0);
        }
        Object.keys(models).forEach(function (value) {
            const opt = document.createElement('option');
            opt.value = value;
            opt.text = models[value];
            el.appendChild(opt);
        });
        if (current !== '') {
            const hasOption = Array.from(el.options).some(function (opt) {
                return opt.value === current;
            });
            if (!hasOption) {
                const legacyOpt = document.createElement('option');
                legacyOpt.value = current;
                legacyOpt.text = current + ' (legacy)';
                el.insertBefore(legacyOpt, el.firstChild);
            }
            el.value = current;
        }
    }

    /**
     * Repopulate a free-text model field's datalist. The typed value is left alone:
     * the list is a suggestion, not a constraint, which is the point for providers
     * whose catalogue cannot be known ahead of time.
     */
    function updateModelDatalist(input, models) {
        let list = input.list;
        if (!list) {
            list = document.createElement('datalist');
            list.id = 'ai-model-options-' + (++datalistSequence);
            input.setAttribute('list', list.id);
            input.parentNode.appendChild(list);
        }

        while (list.firstChild) {
            list.removeChild(list.firstChild);
        }
        Object.keys(models).forEach(function (value) {
            const opt = document.createElement('option');
            opt.value = value;
            opt.text = models[value];
            list.appendChild(opt);
        });
    }

    function refreshModels(button) {
        const resultEl = resultElementFor(button);
        if (!resultEl) return;
        button.disabled = true;
        resultEl.className = 'ai-test-result';
        resultEl.textContent = '{$refreshingLabelJs}';

        const body = new URLSearchParams();
        body.append('service_id', button.dataset.rowId);
        body.append('service_code', button.dataset.serviceCode);
        body.append('form_key', window.FORM_KEY);

        fetch('{$refreshUrlJs}', { method: 'POST', body: body })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (data.success) {
                    updateModelOptions(button.dataset.rowId, button.dataset.serviceCode, data.models);
                    resultEl.classList.add('ai-test-result-success');
                    resultEl.textContent = data.count + ' {$modelsLabelJs}';
                } else {
                    resultEl.classList.add('ai-test-result-error');
                    resultEl.textContent = data.error;
                }
            })
            .catch(function (error) {
                resultEl.classList.add('ai-test-result-error');
                resultEl.textContent = String(error);
            })
            .finally(function () {
                button.disabled = false;
            });
    }

    document.querySelector('.ai-services-configurator').addEventListener('click', function (e) {
        const testButton = e.target.closest('.action-test-connection');
        if (testButton) {
            testConnection(testButton);
            return;
        }
        const refreshButton = e.target.closest('.action-refresh-models');
        if (refreshButton) {
            refreshModels(refreshButton);
            return;
        }
        const renameButton = e.target.closest('.ai-service-rename');
        if (renameButton) {
            toggleNameField(renameButton);
            return;
        }
        const copyButton = e.target.closest('.ai-service-copy-command');
        if (copyButton) {
            copyInstallCommand(copyButton);
            return;
        }
        const deleteButton = e.target.closest('.action-delete');
        if (!deleteButton) return;

        // Credentials are masked, so an administrator cannot retype what a mis-click removed, and
        // the removal becomes permanent on the next save. Asking costs one keystroke.
        if (!window.confirm('{$deleteConfirmJs}')) return;

        const row = document.getElementById(deleteButton.dataset.rowId);
        if (row) row.remove();
        updateEmptyState();
    });

    /**
     * Show or hide the name field of the row whose pencil was pressed, and put the caret in it, so
     * the click that asked to rename something is the last one needed before typing.
     */
    function toggleNameField(button) {
        const rowId = button.dataset.rowRename;
        const nameRow = findByAttribute('data-row-name-row', rowId);
        if (!nameRow) return;

        const reveal = nameRow.hidden;
        nameRow.hidden = !reveal;
        button.setAttribute('aria-expanded', reveal ? 'true' : 'false');

        if (reveal) {
            const field = findByAttribute('data-row-label', rowId);
            if (field) field.focus();
        }
    }

    /**
     * The install hint exists to be pasted into a shell, and it is long enough to be clipped, so
     * copying it should not depend on selecting text that runs past the edge of its box.
     */
    function copyInstallCommand(button) {
        const command = document.querySelector('.ai-service-install-hint');
        if (!command || !navigator.clipboard) return;
        navigator.clipboard.writeText(command.textContent.trim()).then(function () {
            const label = button.querySelector('span');
            label.textContent = button.dataset.copiedLabel;
            window.setTimeout(function () {
                label.textContent = button.dataset.copyLabel;
            }, 2000);
        });
    }


{$existingRowsJs}
    updateEmptyState();
});
script;
    ?>
    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false) ?>
</div>
