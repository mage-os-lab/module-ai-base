<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mageos_ai_usage_listing.mageos_ai_usage_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>mageos_ai_usage_columns</spinner>
        <deps>
            <dep>mageos_ai_usage_listing.mageos_ai_usage_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="mageos_ai_usage_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MageOS_AiBase::usage</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="mageos_ai_usage_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="mageos_ai_usage_columns">
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="10">
            <settings>
                <label translate="true">Date</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <timezone>true</timezone>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="consumer" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="MageOS\AiBase\Model\Usage\Source\Consumer"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Consumer</label>
            </settings>
        </column>
        <column name="service_id" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="MageOS\AiBase\Model\Usage\Source\ServiceRow"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Service</label>
            </settings>
        </column>
        <column name="service_code" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Provider Code</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="model" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Model</label>
            </settings>
        </column>
        <column name="input_tokens" sortOrder="60">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <label translate="true">Input Tokens</label>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="output_tokens" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <label translate="true">Output Tokens</label>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="cache_read_tokens" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <label translate="true">Cache Read Tokens</label>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="cache_write_tokens" sortOrder="90">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <label translate="true">Cache Write Tokens</label>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="reasoning_tokens" sortOrder="100">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <label translate="true">Reasoning Tokens</label>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="total_tokens" sortOrder="110">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <label translate="true">Total Tokens</label>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="failed" component="Magento_Ui/js/grid/columns/select" sortOrder="120">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Failed</label>
            </settings>
        </column>
        <column name="streamed" component="Magento_Ui/js/grid/columns/select" sortOrder="130">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Streamed</label>
            </settings>
        </column>
        <column name="store_id" component="Magento_Ui/js/grid/columns/select" sortOrder="140">
            <settings>
                <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Store</label>
            </settings>
        </column>
    </columns>
</listing>
